      },
      "legal_provisions": {
        "note": "确权与传承相关法律条文（报告10.3章节引用，条文为节选要点，以现行有效版本为准）",
        "insurance_law": [
          {
            "article": "第39条",
            "text": "人身保险的受益人由被保险人或者投保人指定。投保人指定受益人时须经被保险人同意"
          },
          {
            "article": "第40条",
            "text": "可指定一人或数人为受益人并确定受益顺序和份额；未确定份额的，按相等份额享有受益权"
          },
          {
            "article": "第41条",
            "text": "变更受益人须书面通知保险人；投保人变更受益人时须经被保险人同意"
          },
          {
            "article": "第42条",
            "text": "没有指定受益人/受益人指定不明、受益人先于被保险人死亡且无其他受益人、受益人丧失或放弃受益权且无其他受益人的，保险金作为被保险人遗产处理"
          },
          {
            "article": "第43条",
            "text": "受益人故意造成被保险人死亡、伤残、疾病或故意杀害未遂的，丧失受益权"
          },
          {
            "article": "第34条",
            "text": "以死亡为给付条件的保单未经被保险人书面同意不得转让或质押（涉及保单贷款时核实）"
          }
        ],
        "civil_code": [
          {
            "article": "第1122条",
            "text": "遗产是自然人死亡时遗留的个人合法财产"
          },
          {
            "article": "第1123条",
            "text": "继承顺序：遗赠扶养协议>遗嘱继承/遗赠>法定继承"
          },
          {
            "article": "第1127条",
            "text": "法定继承第一顺序：配偶、子女、父母；第二顺序：兄弟姐妹、祖父母、外祖父母"
          },
          {
            "article": "第1130条",
            "text": "同一顺序继承人继承份额一般应当均等"
          },
          {
            "article": "第1153条",
            "text": "遗产分割时，夫妻共同财产应先分出一半为配偶所有，其余为被继承人遗产"
          }
        ],
        "judicial_interpretation_3": [
          {
            "article": "第9条",
            "text": "投保人指定受益人未经被保险人同意的无效；受益人约定为'法定'的以法定继承人为受益人；约定含姓名和身份关系、事故发生时身份关系变化的，认定为未指定受益人"
          },
          {
            "article": "第10条",
            "text": "变更受益人自意思表示发出时生效；未通知保险人的对保险人不发生效力；投保人变更未经被保险人同意的无效"
          },
          {
            "article": "第11条",
            "text": "保险事故发生后变更受益人，变更后的受益人请求给付保险金的，不予支持"
          },
          {
            "article": "第12条",
            "text": "多受益人情形下部分受益人先亡/放弃/丧失受益权的份额处理规则"
          }
        ],
        "individual_income_tax_law": [
          {
            "article": "第4条第（五）项",
            "text": "保险赔款免征个人所得税"
          }
        ]
      },
      "three_rights_framework": {
        "name": "三权分立与定向传承框架",
        "principle": "保险合同的三个角色对应三类不重叠的权利；将三者填对了，理赔金即可定向、免公证、免税传承",
        "roles": {
          "policyholder": {
            "role_name": "投保人",
            "rights": "所有权 + 支配权",
            "description": "交保费的人。掌控保单现金价值、退保权、保单贷款权、受益人指定与变更权（须经被保险人同意）。投保人先于被保险人身故时，现金价值作为投保人遗产处理。",
            "estate_risk": "投保人集中于一人的保单，其身故后现金价值将作为遗产分割，可能引发纠纷并影响后续缴费"
          },
          "insured": {
            "role_name": "被保险人",
            "rights": "保障请求权",
            "description": "受保障的人。享有生存金领取权、理赔请求权，有权指定和变更受益人。其身故触发身故理赔金给付。是保单的'核心人物'。",
            "key_power": "被保险人对受益人的指定权是定向传承的起点——指定了受益人，理赔金就不作为遗产"
          },
          "beneficiary": {
            "role_name": "受益人",
            "rights": "受益金请求权",
            "description": "领取保险金的人。指定受益人的理赔金直接给付受益人，不作为被保险人遗产，免继承公证、免遗产分割纠纷、免征个人所得税。",
            "core_logic": "受益人'指定' → 理赔金不走遗产分配 → 定向传承成功；受益人'法定/未填写' → 理赔金作为遗产 → 须继承公证 → 易产生纠纷"
          }
        },
        "directed_inheritance_chain": [
          "投保人行使受益人指定权（须经被保险人同意）",
          "受益人变更为'指定'（明确姓名+身份证号+份额）",
          "被保险人身故 → 保险金直接给付指定受益人",
          "不作为被保险人遗产 → 免继承公证 → 免遗产分割纠纷 → 免征个税"
        ],
        "why_statutory_is_risk": "受益人留空或填'法定'时，理赔金依法作为被保险人遗产处理（保险法第42条），须经继承权公证方可支取；多成员家庭中继承顺序与份额均需法定继承规则确定，极易产生纠纷"
      }
    }
  },
