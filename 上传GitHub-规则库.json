          },
          {
            "condition": "保单贷款未结清",
            "risk": "high",
            "message": "贷款本息持续累积侵蚀现金价值，本息超过现金价值将导致保单失效、保障中断，建议核实贷款余额与利率并安排还款"
          },
          {
            "condition": "全部保单投保人集中于一人",
            "risk": "medium",
            "message": "投保人先于被保险人身故时保单现金价值将作为投保人遗产处理，可能引发分割纠纷并影响后续缴费，建议评估夫妻互保架构"
          },
