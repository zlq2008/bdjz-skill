          "risk_low": {
            "condition": "<= 1 medical policy",
            "message": "医疗险配置合理"
          }
        },
        {
          "id": "savings_ratio",
          "label": "理财型保费占比",
          "risk_medium": {
            "condition": "savings_premium / total_premium > 0.6",
