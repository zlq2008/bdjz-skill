{
  "version": "1.0",
  "dimensions": {
    "coverage_gap": {
      "name": "保障缺口分析",
      "checks": [
        {
          "id": "ci_amount",
          "label": "重疾保额",
          "risk_high": {
            "condition": "< 300000",
            "color": "#FCEBEB",
            "text_color": "#791F1F",
            "message": "重疾保额低于30万，无法覆盖重疾治疗费用（平均30-50万），存在严重缺口"
          },
          "risk_medium": {
            "condition": "300000-500000",
            "color": "#FAEEDA",
            "text_color": "#633806",
            "message": "重疾保额30-50万，基本够用但建议提升至50万以上"
          },
          "risk_low": {
            "condition": ">= 500000",
            "color": "#E1F5EE",
            "text_color": "#085041",
            "message": "重疾保额充足"
          }
        },
        {
          "id": "life_amount",
          "label": "身故保额",
          "risk_high": {
            "condition": "< annual_income * 5",
            "color": "#FCEBEB",
            "text_color": "#791F1F",
            "message": "身故保额低于年收入5倍，家庭责任保障严重不足"
          },
          "risk_medium": {
            "condition": "annual_income * 5 ~ annual_income * 10",
            "color": "#FAEEDA",
            "text_color": "#633806",
            "message": "身故保额为年收入5-10倍，建议提升至10倍以上"
          },
          "risk_low": {
            "condition": ">= annual_income * 10",
            "color": "#E1F5EE",
            "text_color": "#085041",
            "message": "身故保额充足"
          }
        },
        {
          "id": "medical_amount",
          "label": "医疗保额",
          "risk_high": {
            "condition": "no_medical_insurance",
            "color": "#FCEBEB",
            "text_color": "#791F1F",
            "message": "未配置医疗险，大额医疗费用需自担"
          },
          "risk_medium": {
            "condition": "< 1000000",
            "color": "#FAEEDA",
            "text_color": "#633806",
            "message": "医疗保额低于100万，建议补充百万医疗险"
          },
          "risk_low": {
            "condition": ">= 1000000",
            "color": "#E1F5EE",
            "text_color": "#085041",
            "message": "医疗保额充足"
          }
        },
        {
          "id": "accident_amount",
          "label": "意外保额",
          "risk_high": {
            "condition": "no_accident_insurance",
            "color": "#FCEBEB",
            "text_color": "#791F1F",
            "message": "未配置意外险，意外风险无保障"
          },
          "risk_medium": {
            "condition": "< 500000",
            "color": "#FAEEDA",
            "text_color": "#633806",
            "message": "意外保额低于50万，建议提升"
          },
          "risk_low": {
            "condition": ">= 500000",
            "color": "#E1F5EE",
            "text_color": "#085041",
            "message": "意外保额充足"
          }
        }
      ]
    },
