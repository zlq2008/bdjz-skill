          },
          "risk_low": {
            "condition": "protection_premium / total_premium >= 0.7",
            "message": "保障型保费占比合理"
          }
        },
        {
          "id": "policy_status",
          "label": "保单状态",
          "risk_high": {
            "condition": "停效/失效",
